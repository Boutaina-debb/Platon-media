---
interface Props {
	title?: string;
}
const { title = "Platon Media" } = Astro.props;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html, body {
		margin: 0;
		padding: 0;
		font-family: sans-serif;
	}
</style>
